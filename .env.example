APP_NAME="AMBARA-SISTEM DIGITAL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ambarasmada.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.ugbpqikqduptseeslfri
DB_PASSWORD=
DB_URL="postgresql://user:password@host:5432/database"

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ----------------------------------------------------------------------------
# TEMPLATE SURAT & LAMPIRAN (PERSURATAN)
# ----------------------------------------------------------------------------
# Template .docx dan lampiran surat memakai disk sendiri. Kalau LETTERS_DISK
# dibiarkan kosong, dipakai FILESYSTEM_DISK, dan kalau itu kosong "public".
#
# PENTING untuk produksi: folder aplikasi hanya-baca di Vercel, jadi disk
# local tidak bisa menyimpan berkas. Isi LETTERS_DISK=s3 supaya template dan
# lampiran disimpan ke Supabase Storage (S3-compatible), dengan AWS_* di bawah
# diisi endpoint S3 Supabase.
#
# Contoh endpoint S3 Supabase:
#   AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   AWS_BUCKET=letters
LETTERS_DISK=

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================================
# EMAIL AKTIVASI AKUN
# ============================================================================
# Metode aktif: Gmail SMTP (MAIL_MAILER=smtp). Bisa mengirim ke alamat mana pun
# tanpa perlu verifikasi domain. Batas 500 email/hari.
#
# Gmail menolak password akun biasa. Yang dipakai adalah "App Password":
#   1. Aktifkan 2-Step Verification di https://myaccount.google.com/security
#      (butuh nomor HP aktif untuk menerima kode).
#   2. Buka https://myaccount.google.com/apppasswords
#   3. Buat App Password baru, mis. bernama "AMBARA". Salin 16 karakternya.
#   4. Tempelkan ke MAIL_PASSWORD di bawah TANPA spasi.
#
# MAIL_SCHEME dibiarkan null: pada port 587 Symfony otomatis memakai STARTTLS.
# Jangan menggantinya dengan "ssl" atau menambah MAIL_ENCRYPTION, karena
# Laravel 12 tidak memakai variabel itu dan hasilanya error
# "OpenSSL error:0A00010B ... wrong version number".
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ambarasmada@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ambarasmada@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Alternatif: Resend (MAIL_MAILER=resend)
# ----------------------------------------------------------------------------
# Alternatif: Resend (MAIL_MAILER=resend). Required imbas akun Gmail (kuota
# harian lebih kecil, email lebih sering masuk spam), tetapi WAJIB memverifikasi
# domain sendiri sebelum bisa mengirim ke penerima selain pemilik akun. Tanpa
# domain terverifikasi, Resend hanya mengizinkan pengiriman ke email pemilik
# akun, dengan from = onboarding@resend.dev.
#
# Daftarkan ambarasmada.com dulu di registrar, lalu tambahkan DNS berikut:
#   DKIM   TXT    resend._domainkey  ->  p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCuG0JqJKO+ivSWBdiwqJ64wttsiUzVALiVXG/VFZNkZzMz+oGLUaj8aRLp1LCrA3pmBlmbcMv194r/r0kVFKG/GCAgRWbmALKtZnqRqcgq3BrAN2C490STYcH7peSlvOO78TqOIBadVHsIezl6fXMvztdx6ZKtwq3d+ZY3rgagYwIDAQAB
#   SPF    CNAME  rsend              ->  rsend-apne1.forge.rmta.net
#   SPF    CNAME  send               ->  send.forge.rmta.net
#   DMARC  TXT    _dmarc             ->  v=DMARC1; p=none;
#
# Lalu isi RESEND_API_KEY, ubah MAIL_FROM_ADDRESS ke noreply@ambarasmada.com,
# dan samakan APP_URL dengan domain tersebut (link & logo di email dibangun dari
# APP_URL; ketidakcocokan akan dicatat sebagai peringatan di log).
RESEND_API_KEY=

# Untuk memeriksa tampilan email tanpa mengirim sungguhan: MAIL_MAILER=log
# (isi email ditulis ke laravel.log).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------------
# PETA KONTUR (PMTILES)
# ----------------------------------------------------------------------------
# Arsip PMTiles Sulawesi Selatan tidak ikut dikirim ke Vercel karena .vercelignore
# mengecualikan *.pmtiles. File-nya diletakkan di Supabase Storage bucket
# "maps" dan dibaca browser langsung memakai HTTP Range.
#
# Bentuk URL:
#   https://<project-ref>.supabase.co/storage/v1/object/public/maps/sulsel_kontur.pmtiles
#
# Wajib absolut. Pustaka pmtiles mengambil byte arsip dari host ini, jadi host
# tidak boleh dibuang. Kosongkan untuk memakai berkas lokal di public/.
PMTILES_URL=

VITE_APP_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=https://07809ac890f7ab126faf73aff5e27b14@o4512203552587776.ingest.us.sentry.io/4512203588173824
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true
VERCEL_ANALYTICS_ID=
VERCEL_ANALYTICS_ID=