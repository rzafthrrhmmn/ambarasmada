APP_NAME="AMBARA-SISTEM DIGITAL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ambarasmada.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.ugbpqikqduptseeslfri
DB_PASSWORD=
DB_URL="postgresql://user:password@host:5432/database"

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email aktivasi akun dikirim lewat Resend (https://resend.com/api-keys).
#
# LANGKAH 1 - Daftarkan domain ambarasmada.com di registrar (mis. Cloudflare,
#             Namecheap, Pandi). Domain BELUM bisa dipakai sebelum terdaftar.
# LANGKAH 2 - Tambahkan DNS record berikut di provider domain, lalu tekan
#             "Verify" di dashboard Resend:
#
#   DKIM   TXT    resend._domainkey  ->  p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCuG0JqJKO+ivSWBdiwqJ64wttsiUzVALiVXG/VFZNkZzMz+oGLUaj8aRLp1LCrA3pmBlmbcMv194r/r0kVFKG/GCAgRWbmALKtZnqRqcgq3BrAN2C490STYcH7peSlvOO78TqOIBadVHsIezl6fXMvztdx6ZKtwq3d+ZY3rgagYwIDAQAB
#   SPF    CNAME  rsend              ->  rsend-apne1.forge.rmta.net
#   SPF    CNAME  send               ->  send.forge.rmta.net
#   DMARC  TXT    _dmarc             ->  v=DMARC1; p=none;
#
# LANGKAH 3 - Isi RESEND_API_KEY, lalu pastikan MAIL_FROM_ADDRESS memakai
#             domain yang SUDAH terverifikasi di Resend.
#
# LANGKAH 4 - Samakan APP_URL dengan domain pengirim email. Link verifikasi
#             dan logo di dalam email dibangun dari APP_URL, sedangkan Resend
#             menandai domain "needs attention" bila keduanya berbeda. Karena
#             APP_URL juga mengatur base URL Vite, ambarasmada.com harus
#             sudah terpasang sebagai custom domain di Vercel lebih dulu.
#
#   APP_URL=https://ambarasmada.vercel.app   (sebelum domain siap)
#   APP_URL=https://ambarasmada.com          (setelah domain siap & di Vercel)
#
#   Aplikasi otomatis menulis peringatan "[activation-email] Host link di
#   email tidak sama dengan domain pengirim" ke log bila masih tidak cocok.
RESEND_API_KEY=
MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ambarasmada.com"
MAIL_FROM_NAME="${APP_NAME}"

# Catatan: sebelum domain terverifikasi, Resend akan menolak pengiriman.
# Untuk uji coba tampilan email sementara, pakai MAIL_MAILER=log (isi email
# ditulis ke laravel.log, tidak benar-benar dikirim).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"