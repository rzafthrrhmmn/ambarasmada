# Exclude large map files from Vercel deployment
file dokumen/komponen_peta/Peta_Sulsel.tif
file dokumen/komponen_peta/Peta_Sulsel.tif.aux.xml
file dokumen/komponen_komponen_peta/sulsel_kontur.geojson
file dokumen/komponen_peta/sulsel_kontur.geojson
file dokumen/komponen_peta/sulsel_kontur.gpkg
public/storage/maps/*.pmtiles

# Other common exclusions
node_modules
vendor
.vercel
.kilo
.env
.env.*
*.log
storage/*.log
supabase
tests
coverage
/.git

# Bootstrap cache files are auto-generated at runtime by api/index.php,
# but packages.php and services.php are precomputed and deployed because
# vendor/ is excluded so PackageManifest::build() cannot run on Vercel.
# api/index.php copies these to /tmp/bootstrap/cache/ at runtime.
!bootstrap/cache/packages.php
!bootstrap/cache/services.php

# Skrip debug sekali pakai dan wireframe desain
check_login.php
test_hash.php
test_hash2.php
_probe*.php
wireframe
