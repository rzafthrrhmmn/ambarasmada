# Exclude large map files from Vercel deployment
file dokumen/komponen_peta/Peta_Sulsel.tif
file dokumen/komponen_peta/Peta_Sulsel.tif.aux.xml
file dokumen/komponen_komponen_peta/sulsel_kontur.geojson
file dokumen/komponen_peta/sulsel_kontur.geojson
file dokumen/komponen_peta/sulsel_kontur.gpkg
public/storage/maps/*.pmtiles

# Other common exclusions
node_modules
vendor
.vercel
.kilo
.env
.env.*
*.log
storage/*.log
supabase
tests
coverage
/.git

# Bootstrap cache files are auto-generated by Laravel at runtime
# (api/index.php deletes + regenerates them). They are NOT excluded so the
# bootstrap/cache directory exists during the build-time composer scripts.
# Keeping them committed/deployed is harmless — they get overwritten.

# Skrip debug sekali pakai dan wireframe desain
check_login.php
test_hash.php
test_hash2.php
_probe*.php
wireframe
