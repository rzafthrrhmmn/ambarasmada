# Exclude large map files from Vercel deployment
file dokumen/komponen_peta/Peta_Sulsel.tif
file dokumen/komponen_peta/Peta_Sulsel.tif.aux.xml
file dokumen/komponen_komponen_peta/sulsel_kontur.geojson
file dokumen/komponen_peta/sulsel_kontur.geojson
file dokumen/komponen_peta/sulsel_kontur.gpkg
public/storage/maps/*.pmtiles

# Other common exclusions
node_modules
vendor
.vercel
.kilo
.env
.env.*
*.log
storage/*.log
supabase
tests
coverage
/.git

# Vercel PHP files are no longer Serverless Functions
# Node.js function in api/index.js handles all PHP requests via built-in server
api/index.php
api/status.php

# Include bootstrap cache prebuilt at build time (vendor/ is excluded, so
# PackageManifest::build() cannot run on Vercel). server.php copies these
# to /tmp/bootstrap/cache/ at runtime.
!bootstrap/cache/packages.php
!bootstrap/cache/services.php

# Include @libphp PHP runtime (Linux binary for built-in server) even though
# node_modules is excluded. Vercel Node.js function uses require.resolve()
# to locate the PHP binary at runtime.
!node_modules/@libphp/almalinux-9-v85
# Include laravel-vendor package (wraps vendor/ and app files as tarballs for @vercel/nft)
!node_modules/laravel-vendor
# Include tar package for runtime extraction (pure JS, no system tar needed)
!node_modules/tar
!node_modules/minipass
!node_modules/mkdirp

# Skrip debug sekali pakai dan wireframe desain
check_login.php
test_hash.php
test_hash2.php
_probe*.php
wireframe
