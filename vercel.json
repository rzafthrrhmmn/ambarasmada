{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60
    },
    "api/status.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/build/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/status.php",
      "dest": "/api/status.php"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/public/manifest.webmanifest"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/sw.js",
      "dest": "/public/sw.js"
    },
    {
      "src": "/offline.html",
      "dest": "/public/offline.html"
    },
    {
      "src": "/build/(.*)",
      "dest": "/public/build/"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/"
    },
    {
      "src": "/vendors/(.*)",
      "dest": "/public/vendors/"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/public/storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "AMBARA-SISTEM DIGITAL",
    "APP_ENV": "production",
    "APP_DEBUG": "0",
    "APP_URL": "https://${VERCEL_PROJECT_PRODUCTION_URL}",

    "APP_LOCALE": "en",
    "APP_FALLBACK_LOCALE": "en",
    "APP_FAKER_LOCALE": "en_US",
    "APP_MAINTENANCE_DRIVER": "file",
    "APP_STORAGE": "/tmp/storage",
    "APP_CONFIG_CACHE": "/tmp/bootstrap/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/bootstrap/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/bootstrap/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "database",
    "CACHE_DRIVER": "database",
    "QUEUE_CONNECTION": "database",
    "LOG_CHANNEL": "stderr",
    "LOG_DEPRECATIONS_CHANNEL": "null",
    "LOG_LEVEL": "error",
    "SESSION_DRIVER": "file",
    "SESSION_LIFETIME": "120",
    "SESSION_ENCRYPT": "true",
    "SESSION_PATH": "/",

    "SESSION_SECURE_COOKIE": "true",
    "SESSION_SAMESITE": "none",
    "SESSION_PARTITIONED_COOKIE": "true",
    "BROADCAST_CONNECTION": "log",
    "FILESYSTEM_DISK": "local",
    "LETTERS_DISK": "s3",
    "BCRYPT_ROUNDS": "12",
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "aws-0-ap-southeast-1.pooler.supabase.com",
    "DB_PORT": "6543",
    "DB_DATABASE": "postgres",

    "REDIS_CLIENT": "phpredis",
    "REDIS_HOST": "127.0.0.1",

    "REDIS_PORT": "6379",
    "MAIL_MAILER": "smtp",

    "MAIL_FROM_NAME": "AMBARA-SISTEM DIGITAL",



    "SENTRY_TRACES_SAMPLE_RATE": "1.0",
    "SENTRY_PROFILES_SAMPLE_RATE": "1.0",
    "SENTRY_ENABLE_LOGS": "true"
  }
}