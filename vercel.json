{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
      "api/index.php": {
          "runtime": "vercel-php@0.9.0",
          "maxDuration": 30
      }
  },
  "routes": [
      {
          "src": "/build/(.*)",
          "dest": "/dist/build/$1",
          "headers": {
              "Cache-Control": "public, max-age=31536000, immutable"
          }
      },
      {
          "src": "/css/(.*)",
          "dest": "/dist/css/$1",
          "headers": {
              "Cache-Control": "public, max-age=31536000, immutable"
          }
      },
      {
          "src": "/images/(.*)",
          "dest": "/dist/images/$1",
          "headers": {
              "Cache-Control": "public, max-age=31536000, immutable"
          }
      },
      {
          "src": "/js/(.*)",
          "dest": "/dist/js/$1",
          "headers": {
              "Cache-Control": "public, max-age=31536000, immutable"
          }
      },
      {
          "src": "/favicon.ico",
          "dest": "/public/favicon.ico"
      },
      {
          "src": "/manifest.webmanifest",
          "dest": "/public/manifest.webmanifest"
      },
      {
          "src": "/sw.js",
          "dest": "/public/sw.js"
      },
      {
          "src": "/(.*)",
          "dest": "/api/index.php"
      }
  ],
  "env": {
      "APP_ENV": "production",
      "APP_DEBUG": "false",
      "APP_URL": "https://ambarasmada.vercel.app",
      "LOG_CHANNEL": "stderr",
      "SESSION_DRIVER": "cookie",
      "CACHE_DRIVER": "array",
      "CACHE_STORE": "array",
      "QUEUE_CONNECTION": "sync",
      "DB_CONNECTION": "pgsql",
      "DB_HOST": "aws-0-ap-southeast-1.pooler.supabase.com",
      "DB_PORT": "6543",
      "DB_DATABASE": "postgres",
      "DB_USERNAME": "postgres.ugbpqikqduptseeslfri",
      "DB_SSLMODE": "require",
      "DB_PASSWORD": "RezaNeko26@",
      "FILESYSTEM_DISK": "public"
  }
}